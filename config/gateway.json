{
  "rate_limit": {
    "rate_per_second": 5,
    "burst": 10
  },
  "upstreams": {
    "api": {
      "instances": [
        {"id": "api-1", "url": "http://127.0.0.1:9001", "weight": 5},
        {"id": "api-2", "url": "http://127.0.0.1:9002", "weight": 1},
        {"id": "api-3", "url": "http://127.0.0.1:9003", "weight": 1}
      ],
      "health_path": "/health",
      "health_interval": 1.0,
      "health_timeout": 1.0,
      "max_inflight": 2,
      "failure_threshold": 3,
      "recover_threshold": 1,
      "open_state_ttl": 2.0,
      "warmup_seconds": 5.0,
      "warmup_initial_ratio": 0.1
    }
  },
  "routes": [
    {
      "id": "api",
      "prefix": "/api",
      "upstream": "api",
      "strip_prefix": true,
      "timeout": 1.5,
      "max_retries": 2
    }
  ]
}
